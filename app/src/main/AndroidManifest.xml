<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 主題下載區下載的主題檔（.json）：在下載通知、檔案管理員點一下就能匯入 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!-- 我的貼圖：鍵盤送圖片給別的 App 時，用這個讓對方讀那一張（不公開，只給暫時權限） -->
        <provider
            android:name=".StickerProvider"
            android:authorities="${applicationId}.stickers"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 主題工作室：從設定、桌面小工具打開；在最近使用的 App 裡像另一個 App（不再有自己的桌面圖示） -->
        <activity
            android:name=".StudioActivity"
            android:exported="false"
            android:icon="@mipmap/ic_studio"
            android:label="@string/studio_name"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.studio" />

        <!-- 桌面小工具「主題工作室」：需要的人自己加到桌面 -->
        <receiver
            android:name=".StudioWidget"
            android:exported="true"
            android:label="@string/studio_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/studio_widget_info" />
        </receiver>

        <service
            android:name=".CatImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
